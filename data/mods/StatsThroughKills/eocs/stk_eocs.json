[
  {
    "type": "effect_on_condition",
    "id": "EOC_stk_open_menu",
    "effect": [ { "open_dialogue": { "topic": "TALK_STK_MENU_MAIN" } } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_stk_game_start",
    "eoc_type": "EVENT",
    "required_event": "game_begin",
    "condition": { "and": [ { "not": { "u_has_trait": "stk_container" } } ] },
    "effect": [
      {
        "u_message": "Stats Through Kills - EOC loaded!  You should now have a mutation called \"StK Leveling\" that can be activated at any time to access the level-up and configuration menus.  If you do not, you can enable the mod manually by activating the \"EOC_stk_init\" EOC in debug."
      },
      { "run_eocs": "EOC_stk_init" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_stk_init",
    "condition": { "and": [ { "not": { "u_has_trait": "stk_container" } } ] },
    "effect": [
      { "math": [ "u_stk_exp_to_level = 1000" ] },
      { "math": [ "u_stk_exp_mult = 1000" ] },
      { "math": [ "u_stk_exp_const = 0" ] },
      { "math": [ "u_stk_exp_current = 0" ] },
      { "math": [ "u_stk_level = 0" ] },
      { "math": [ "u_stk_max_level = 20" ] },
      { "math": [ "u_stk_points = 0" ] },
      { "math": [ "u_stk_silent = 0" ] },
      { "math": [ "u_stk_debug = 0" ] },
      { "u_add_trait": "stk_container" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_stk_on_kill_update",
    "eoc_type": "EVENT",
    "required_event": "character_kills_monster",
    "effect": [ { "math": [ "u_stk_exp_current += _exp" ] }, { "run_eocs": "EOC_stk_level_up" } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_stk_exp_to_level",
    "effect": [ { "math": [ "u_stk_exp_to_level = u_stk_exp_mult * (u_stk_level + 1) + u_stk_exp_const" ] } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_stk_level_up",
    "condition": {
      "and": [
        { "math": [ "u_stk_exp_current >= u_stk_exp_to_level" ] },
        { "or": [ { "math": [ "u_stk_level < u_stk_max_level" ] }, { "math": [ "u_stk_max_level < 0" ] } ] }
      ]
    },
    "effect": [
      { "math": [ "u_stk_points++" ] },
      { "math": [ "u_stk_level++" ] },
      { "math": [ "u_stk_exp_current -= u_stk_exp_to_level" ] },
      { "run_eocs": [ "EOC_stk_exp_to_level", "EOC_stk_level_up_notification" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_stk_level_up_notification",
    "condition": { "math": [ "u_stk_silent != 1" ] },
    "effect": [ { "open_dialogue": { "topic": "TALK_STK_MENU_MAIN" } } ]
  }
]
