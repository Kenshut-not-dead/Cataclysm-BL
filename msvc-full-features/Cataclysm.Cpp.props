<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_CBL_USE_CCACHE>false</_CBL_USE_CCACHE>
    <_CBL_USE_CCACHE Condition="'$(CBL_USE_CCACHE)'!='' And !$(Configuration.StartsWith(Debug))">true</_CBL_USE_CCACHE>
  </PropertyGroup>
  <PropertyGroup Condition="$(_CBL_USE_CCACHE)">
    <UseMultiToolTask>true</UseMultiToolTask>
  </PropertyGroup>
</Project>
